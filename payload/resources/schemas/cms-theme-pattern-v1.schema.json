{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinoox.local/schemas/cms-theme-pattern-v1.schema.json",
  "title": "NanoPino Theme Pattern v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "document"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "categories": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "document": {
      "$ref": "cms-block-document-v1.schema.json"
    }
  }
}
