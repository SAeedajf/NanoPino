<!doctype html>
<html lang="{{ bootstrap.locale|default('fa') }}" dir="{{ bootstrap.direction|default('rtl') }}"
      data-cms-boot="server"
      {% if adminFrontend.ready|default(false) %}data-cms-frontend-ready="1"{% else %}data-cms-frontend-ready="0"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="noindex,nofollow">
    <meta name="referrer" content="same-origin">
    <title>{{ t('admin.brand.admin_title') }}</title>
    <style>
        :root {
            color-scheme: light dark;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }
        body {
            margin: 0;
            min-height: 100vh;
            background: Canvas;
            color: CanvasText;
        }
        #app {
            min-height: 100vh;
        }
        .cms-boot-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1rem;
            box-sizing: border-box;
        }
        .cms-boot-card {
            width: min(100%, 48rem);
            box-sizing: border-box;
            border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
            border-radius: 1rem;
            padding: 1rem;
            background: Canvas;
            box-shadow: 0 .75rem 2rem color-mix(in srgb, CanvasText 8%, transparent);
        }
        .cms-boot-card h1 {
            margin: 0 0 .5rem;
            font-size: 1.15rem;
        }
        .cms-boot-card p {
            margin: .35rem 0;
            line-height: 1.8;
        }
        .cms-boot-code {
            display: block;
            width: 100%;
            box-sizing: border-box;
            margin-block: .75rem;
            padding: .75rem;
            border: 0;
            border-radius: .65rem;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
            direction: ltr;
            text-align: left;
            background: color-mix(in srgb, CanvasText 7%, transparent);
            color: inherit;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }
        .cms-boot-meta {
            display: grid;
            grid-template-columns: 1fr;
            gap: .5rem;
            margin-top: 1rem;
        }
        .cms-boot-meta > div {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            border-top: 1px solid color-mix(in srgb, CanvasText 12%, transparent);
            padding-top: .5rem;
        }
        .cms-boot-muted {
            opacity: .72;
            font-size: .9rem;
        }
        .cms-boot-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin-top: 1rem;
        }
        .cms-boot-action {
            min-height: 2.75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            padding: .6rem .9rem;
            border: 1px solid color-mix(in srgb, CanvasText 20%, transparent);
            border-radius: .65rem;
            background: Canvas;
            color: CanvasText;
            font: inherit;
            text-decoration: none;
            cursor: pointer;
        }
        .cms-boot-action:focus-visible {
            outline: 3px solid Highlight;
            outline-offset: 2px;
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                scroll-behavior: auto !important;
                animation-duration: .001ms !important;
                transition-duration: .001ms !important;
            }
        }
        @media (min-width: 48rem) {
            .cms-boot-card { padding: 1.25rem 1.5rem; }
            .cms-boot-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
    </style>
    {% include 'partials/scripts.twig' %}
</head>
<body>
<div id="app">
    {% if adminFrontend.ready|default(false) %}
        <main id="cms-boot-loading" class="cms-boot-shell" aria-live="polite" aria-busy="true">
            <section class="cms-boot-card">
                <h1>{{ t('admin.shell.booting_title') }}</h1>
                <p class="cms-boot-muted">
                    {{ t('admin.shell.booting_message') }}
                </p>
                {% if adminFrontend.buildId|default(null) %}
                    <div class="cms-boot-meta">
                        <div><span>{{ t('admin.brand.name') }}</span><strong>{{ release.version|default(t('admin.shell.unknown')) }}</strong></div>
                        <div><span>Build</span><strong>{{ adminFrontend.buildId }}</strong></div>
                    </div>
                {% endif %}
            </section>
        </main>
        <noscript>
            <style>#cms-boot-loading{display:none!important}</style>
            <main class="cms-boot-shell" role="alert">
                <section class="cms-boot-card">
                    <h1>{{ t('admin.shell.javascript_disabled_title') }}</h1>
                    <p>{{ t('admin.shell.javascript_disabled_message') }}</p>
                    <code class="cms-boot-code">cms.admin.javascript_disabled</code>
                </section>
            </main>
        </noscript>
    {% else %}
        <main class="cms-boot-shell" role="alert">
            <section class="cms-boot-card">
                <h1>{{ t('admin.shell.frontend_unavailable_title') }}</h1>
                <p>
                    {{ t('admin.shell.frontend_unavailable_message') }}
                </p>

                <code class="cms-boot-code">{{ adminFrontend.code|default('cms.admin.assets_unavailable') }}</code>
                <p>{{ adminFrontend.message|default('Admin frontend assets are unavailable.') }}</p>

                <p class="cms-boot-muted">
                    {{ t('admin.shell.build_hint') }}
                </p>

                <code class="cms-boot-code">php pinoox fe com_pinoox_cms install --theme=cms-admin
php pinoox fe com_pinoox_cms build --theme=cms-admin</code>

                <p class="cms-boot-muted">
                    {{ t('admin.shell.shared_hosting_hint') }}
                </p>

                <div class="cms-boot-meta">
                    <div><span>{{ t('admin.brand.name') }}</span><strong>{{ release.version|default(t('admin.shell.unknown')) }}</strong></div>
                    <div><span>Mode</span><strong>{{ adminFrontend.mode|default('unknown') }}</strong></div>
                    <div><span>Entry</span><strong>{{ adminFrontend.entry|default('src/main.js') }}</strong></div>
                    <div><span>Manifest</span><strong>{{ adminFrontend.manifest|default('dist/.vite/manifest.json') }}</strong></div>
                </div>

                <div class="cms-boot-actions">
                    <a class="cms-boot-action" href="">{{ t('admin.shell.retry') }}</a>
                </div>
            </section>
        </main>
    {% endif %}
</div>
</body>
</html>
