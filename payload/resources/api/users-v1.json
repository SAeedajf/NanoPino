{
  "name": "CMS Users & Capabilities API v1",
  "version": "v1",
  "base": "/api/v1/cms",
  "identity_owner": "Pinoox Identity/RBAC",
  "endpoints": {
    "GET /users": {
      "permission": "users.read",
      "query": {
        "q": "optional string <= 190",
        "status": "active|inactive|suspend|pending",
        "role": "optional role key",
        "limit": "1..100, default 50",
        "offset": "integer >= 0"
      },
      "response": ["items", "roles", "role_templates", "capabilities", "summary", "current", "statuses", "pagination"]
    },
    "POST /users": {"permission": "users.create", "password_min_length": 8},
    "PATCH /users/{id}": {"permission": "users.update", "password_status_roles_abilities_ignored": true},
    "PATCH /users/{id}/status": {"permission": "users.update", "self_disable_blocked": true},
    "POST /users/{id}/roles/{role}": {"permission": "users.roles.manage"},
    "DELETE /users/{id}/roles/{role}": {"permission": "users.roles.manage", "self_role_detach_blocked": true},
    "POST /users/{id}/sessions/revoke": {"permission": "users.sessions.revoke"},
    "DELETE /users/{id}": {"permission": "users.delete", "self_delete_blocked": true}
  },
  "pagination": {"default_limit": 50, "max_limit": 100, "offset": true, "total": true, "has_more": true},
  "security": {
    "parallel_identity_store": false,
    "server_authorization_authoritative": true,
    "current_account_lockout_guards": true,
    "role_assignment_uses_pinoox_access": true,
    "session_revocation_uses_pinoox_auth": true
  }
}
